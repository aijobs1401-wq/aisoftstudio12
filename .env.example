# Public browser configuration (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_META_APP_ID=YOUR_META_APP_ID
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=YOUR_META_EMBEDDED_SIGNUP_CONFIG_ID
NEXT_PUBLIC_META_GRAPH_API_VERSION=v23.0

# Server-only secrets — NEVER use NEXT_PUBLIC_ for these
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_EMBEDDED_SIGNUP_CONFIG_ID=YOUR_META_EMBEDDED_SIGNUP_CONFIG_ID
META_WEBHOOK_VERIFY_TOKEN=YOUR_RANDOM_WEBHOOK_VERIFY_TOKEN
META_GRAPH_API_VERSION=v23.0
WHATSAPP_TOKEN_ENCRYPTION_KEY=64_HEX_CHARACTERS_FOR_32_BYTES

# Razorpay billing (optional until paid plans are enabled)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Public application URL
NEXT_PUBLIC_SITE_URL=https://aisoftstudio12.onrender.com
